using System;

class Program
{
    static string[,] users = {
        { "Admin", "admin123" },
        { "User1", "password1" },
        { "Guest", "guest123" }
    };

    static string token = null; 
    static int attemptsLeft = 3;

    static void Main(string[] args)
    {
        bool running = true;
        while (running)
        {
            Console.Clear();
            Console.WriteLine("Welcome! Choose an option:");
            Console.WriteLine("1. Login");
            Console.WriteLine("2. Global Check (String Exercises)");
            Console.WriteLine("3. Authorization Check");
            Console.WriteLine("4. Logout");
            Console.Write("Enter your choice: ");

            string choice = Console.ReadLine();

            switch (choice)
            {
                case "1": Login(); break;
                case "2": GlobalCheck(); break;
                case "3": AuthorizationCheck(); break;
                case "4": Logout(); running = false; break;
                default: Console.WriteLine("Invalid choice!"); break;
            }

            Console.WriteLine("\nPress Enter to continue...");
            Console.ReadLine();
        }
    }

    static void Login()
    {
        if (attemptsLeft == 0)
        {
            Console.WriteLine("Account locked. No attempts left.");
            return;
        }

        Console.Write("Enter Username: ");
        string username = Console.ReadLine();

        Console.Write("Enter Password: ");
        string password = Console.ReadLine();

        bool success = false;

        for (int i = 0; i < users.GetLength(0); i++)
        {
            if (username.Equals(users[i, 0], StringComparison.OrdinalIgnoreCase) &&
                password == users[i, 1])
            {
                success = true;
                char[] reversedPass = password.ToCharArray();
                Array.Reverse(reversedPass);
                token = new string(reversedPass) + username;

                Console.WriteLine("Login Successful!");
                Console.WriteLine("Generated Token: " + token);

                attemptsLeft = 3; 
                break;
            }
        }

        if (!success)
        {
            attemptsLeft--;
            Console.WriteLine("Invalid credentials. Attempts left: " + attemptsLeft);
        }
    }

    static void GlobalCheck()
    {
        Console.WriteLine("Welcome to the Global Check!");
        Console.WriteLine("Choose an activity:");
        Console.WriteLine("1. Reverse a sentence");
        Console.WriteLine("2. Search for a word in a paragraph");
        Console.WriteLine("3. Go back to the main menu");
        Console.Write("Enter your choice: ");

        string choice = Console.ReadLine();

        switch (choice)
        {
            case "1":
                Console.Write("Enter a sentence: ");
                string sentence = Console.ReadLine();
                string[] words = sentence.Split(' ');
                Array.Reverse(words);
                Console.WriteLine("Reversed sentence: " + string.Join(" ", words));
                break;

            case "2":
                string paragraph = "Learning C# is fun and powerful for building applications.";
                Console.WriteLine("Paragraph: " + paragraph);
                Console.Write("Enter a word to search: ");
                string word = Console.ReadLine();

                if (paragraph.Contains(word, StringComparison.OrdinalIgnoreCase))
                    Console.WriteLine($"The word \"{word}\" exists in the paragraph.");
                else
                    Console.WriteLine($"The word \"{word}\" was not found.");
                break;

            case "3":
                Console.WriteLine("Returning to the main menu...");
                break;

            default:
                Console.WriteLine("Invalid choice.");
                break;
        }
    }

    static void AuthorizationCheck()
    {
        if (token != null)
        {
            Console.WriteLine("You're currently viewing this page as an authorized user.");
        }
        else
        {
            Console.WriteLine("Unauthorized view. Please log in to access this page.");
        }
    }

    static void Logout()
    {
        Console.WriteLine("Logging out...");
        token = null;
        attemptsLeft = 3;
        Console.WriteLine("Token cleared.");
    }
}
